# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# uv / venv
.venv/

# local sandbox for driving the CLI by hand: a REFRACT_HOME with providers/mcp and a
# scratch project scaffolded from a template. Environment, not project content.
.refract-home/
claude-demo/
# live-run sandboxes: the projects the engine was validated on (brief + pipeline + the
# artifacts those runs produced). Same category as claude-demo/ — a workbench, not the
# product. terror-report/evidence/ keeps the expensive artifacts of six deleted runs.
tavily-smoke/
terror-report/
attn-article/

# refract run outputs
runs/
illustrator-sample/

# Local agent permissions: names the MCP servers of THIS machine (including a
# corporate one), so it is environment config, not project content. The reusable
# part of .claude/ — the reviewer agents — stays tracked.
.claude/settings.json

# Internal documents: specs, engine design, roadmap, progress log, ops notes. The repo is
# public; these are not. README's illustrations live in assets/ instead, so nothing here
# needs an exception.
docs/
# local test-run scratch
.smoke-home/
.illus-smoke/
.pb-cli/
*.smoke-proj
.illus-proj
test-run/

# frontend (SPEC-UI): deps and build output
web/node_modules/
web/dist/

web/test-results/
web/playwright-report/

# IDE scratch that landed in the templates dir by accident
.idea/
*.code-workspace
attn-v2/
RESULT/
